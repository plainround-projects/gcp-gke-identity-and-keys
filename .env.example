# Copy to .env (git-ignored). Only the cloud scripts under scripts/ read these.
PROJECT_ID=example-sandbox-0000          # your lab project id
REGION=europe-west1
BILLING_ACCOUNT=AAAAAA-BBBBBB-CCCCCC      # gcloud billing accounts list
ORG_ID=                                   # gcloud organizations list; leave empty without an organization
MASTER_AUTHORIZED_CIDR=203.0.113.7/32     # your public address as a /32; 203.0.113.0/24 is a documentation range
